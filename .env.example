# Copy to .env for local runs. In GitHub, add each of these as a repository secret
# (Settings -> Secrets and variables -> Actions). Never commit real values.

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# Shopify: Dev Dashboard app installed on justtennis-822 (client credentials grant)
SHOPIFY_SHOP=justtennis-822
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or a legacy custom-app Admin API token instead of the two above
SHOPIFY_ACCESS_TOKEN=

# ShipStation API v2 key
SHIPSTATION_API_KEY=
